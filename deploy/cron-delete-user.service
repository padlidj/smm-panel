[Unit]
Description=SMM Panel - Cron: Delete Unverified Users
After=network.target

[Service]
Type=oneshot
User=padsu
WorkingDirectory=/home/padsu/scripts/smm-panel
ExecStart=/home/padsu/scripts/smm-panel/node_modules/.bin/tsx /home/padsu/scripts/smm-panel/cron/delete-user.ts

[Install]
WantedBy=multi-user.target